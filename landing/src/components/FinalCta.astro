---
import Logo from "./Logo.astro";
import OrbitRank from "./OrbitRank.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
---

<section class="relative overflow-hidden pt-28 sm:pt-36">
  <div class="container-x relative flex flex-col items-center gap-12 text-center">
    <h2 data-reveal class="max-w-[820px] font-head text-[40px] leading-[1.04] font-semibold tracking-[-0.03em] sm:text-[64px]">Cada hoja de vida merece una lectura completa.</h2>

    <div class="grid w-full max-w-[900px] gap-4 text-left md:grid-cols-2">
      <div data-reveal style="--i:1" class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-7">
        <span class="text-[13px] font-medium text-amber">Si contratas</span>
        <p class="font-head text-[22px] leading-snug font-semibold">Crea la vacante, recibe hojas de vida y mira el ranking con sus pruebas.</p>
        <a href={`${appUrl}/login`} class="btn btn-ink mt-auto self-start">Publicar una vacante</a>
      </div>
      <div data-reveal style="--i:2" class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-7">
        <span class="text-[13px] font-medium text-blue">Si buscas empleo</span>
        <p class="font-head text-[22px] leading-snug font-semibold">Sube tu hoja de vida una vez y postúlate a las vacantes abiertas.</p>
        <a href="#vacantes" class="btn btn-line mt-auto self-start">Subir mi hoja de vida</a>
      </div>
    </div>
  </div>

  <div class="mt-10">
    <OrbitRank />
  </div>

  <footer class="relative border-t border-border">
    <div class="container-x flex flex-col items-start justify-between gap-4 py-8 md:flex-row md:items-center">
      <Logo />
      <nav aria-label="Legal" class="flex gap-5 text-[12.5px] text-ink-3">
        <span>Privacidad</span>
        <span>Términos</span>
        <span>Contacto</span>
      </nav>
      <p class="text-[12.5px] text-ink-3">© 2026 Criba</p>
    </div>
  </footer>
</section>
