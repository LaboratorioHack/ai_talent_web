---
/**
 * Vacantes abiertas para quien busca empleo: se puede postular con la hoja de
 * vida que ya tiene. Cada tarjeta abre la página pública de la vacante en la
 * app (/jobs/{id}). Datos de ejemplo mientras la API no exponga las vacantes
 * públicas; la empresa es la misma organización ficticia de la demo.
 */
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
const roles = [
  { id: "v-cloud", title: "Ingeniero Cloud Senior", company: "Cordillera Financiera", place: "Medellín, híbrido", closes: "30 nov", reqs: ["Azure", "Kubernetes", "Terraform"] },
  { id: "v-data", title: "Analista de Datos", company: "Cordillera Financiera", place: "Bogotá, remoto", closes: "18 nov", reqs: ["SQL", "Power BI", "Estadística"] },
  { id: "v-backend", title: "Desarrollador Backend Jr", company: "Cordillera Financiera", place: "Remoto", closes: "22 nov", reqs: [".NET o Java", "APIs REST", "Git"] },
  { id: "v-ux", title: "Diseñador UX", company: "Cordillera Financiera", place: "Cali, híbrido", closes: "28 nov", reqs: ["Investigación", "Figma", "Prototipos"] },
  { id: "v-sec", title: "Especialista en Ciberseguridad", company: "Cordillera Financiera", place: "Bogotá, presencial", closes: "12 dic", reqs: ["SIEM", "ISO 27001", "Respuesta a incidentes"] },
  { id: "v-product", title: "Líder de Producto", company: "Cordillera Financiera", place: "Remoto", closes: "5 dic", reqs: ["Roadmap", "Métricas", "Equipos ágiles"] },
];
---

<section id="vacantes" class="relative scroll-mt-24 py-28 sm:py-36">
  <div class="container-x flex flex-col gap-12">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="flex max-w-[620px] flex-col gap-4">
        <span data-reveal class="eyebrow">Vacantes abiertas</span>
        <h2 data-reveal style="--i:1" class="font-head text-[36px] leading-[1.05] font-semibold tracking-[-0.025em] sm:text-[48px]">Postúlate con la hoja de vida que ya tienes.</h2>
        <p data-reveal style="--i:2" class="text-[16px] leading-relaxed text-ink-2">No hace falta reescribirla ni llenar formularios largos. Cada empresa ve tu experiencia con el mismo criterio que la de los demás.</p>
      </div>
      <a data-reveal style="--i:3" href="#vacantes-lista" class="btn btn-line shrink-0">Subir mi hoja de vida</a>
    </div>

    <ul id="vacantes-lista" class="grid scroll-mt-28 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        roles.map((r, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <a href={`${appUrl}/jobs/${r.id}`} class="role group flex h-full flex-col gap-5 rounded-2xl border border-border bg-surface p-6">
              <div class="flex flex-col gap-1">
                <span class="text-[13px] text-ink-3">{r.company}</span>
                <span class="font-head text-[21px] leading-tight font-semibold tracking-[-0.01em] text-ink">{r.title}</span>
                <span class="text-[13px] text-ink-2">{r.place}</span>
              </div>
              <ul class="flex flex-wrap gap-1.5">
                {r.reqs.map((q) => (
                  <li class="rounded-full border border-border px-2.5 py-1 text-[12px] text-ink-2">{q}</li>
                ))}
              </ul>
              <div class="mt-auto flex items-center justify-between border-t border-border pt-4 text-[13px]">
                <span class="text-ink-3">Cierra el {r.closes}</span>
                <span class="cta flex items-center gap-1.5 font-medium text-ink">
                  Postularme
                  <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true">
                    <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .role {
    transition:
      transform 600ms var(--ease-out-soft),
      border-color 500ms var(--ease-out-soft),
      background-color 500ms var(--ease-out-soft);
  }
  .role:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .role .cta svg {
    transition: transform 600ms var(--ease-spring);
  }
  .role:hover .cta svg {
    transform: translate(2px, -2px);
  }
</style>
