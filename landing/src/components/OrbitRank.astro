---
/**
 * El cierre de la landing: la órbita de Criba. Un cuenco en 3D cuyos anillos
 * son órbitas; en ellas giran hojas de vida, siempre de frente. Cuanto más
 * cerca de la vacante (el centro), mejor encajan: las del anillo interior
 * llevan su línea marcada en ámbar y brillan; las de afuera, apagadas. Cada pocos segundos un pulso de
 * lectura viaja de afuera hacia el centro. Nada se descarta ni cae.
 * Todo es transform y opacity: lo hace el compositor.
 */
const DEPTH = 90;
const WALL = 12;
const orbits = [
  { r: 0.44, dur: 40, level: "fit", docs: [10, 130, 250] },
  { r: 0.72, dur: 64, level: "mid", docs: [60, 160, 240, 330] },
  { r: 0.98, dur: 100, level: "far", docs: [30, 100, 170, 230, 300] },
];
const rings = [1, 0.84, 0.68, 0.52, 0.36, 0.2];
const ringDots = (r: number) => Math.round(14 + r * 44);
const z = (r: number) => -(1 - r * r) * DEPTH;
---

<div class="orbit relative mx-auto h-[600px] w-full max-w-[1100px] overflow-hidden" aria-hidden="true">
  <div class="glow absolute bottom-[-150px] left-1/2 h-[460px] w-[900px] -translate-x-1/2"></div>

  <!-- La vacante, flotando sobre el centro del cuenco -->
  <div class="vacancy-pin absolute left-1/2 top-[64px] z-10 flex -translate-x-1/2 flex-col items-center">
    <div class="vacancy">
      <span class="vacancy-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path d="M5.5 4V3a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 10.5 3v1M2 5.5A1.5 1.5 0 0 1 3.5 4h9A1.5 1.5 0 0 1 14 5.5v6A1.5 1.5 0 0 1 12.5 13h-9A1.5 1.5 0 0 1 2 11.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
      </span>
      <span class="vacancy-title">Vacante</span>
    </div>
    <span class="pin-line"></span>
  </div>

  <div class="stage absolute top-[52%] left-1/2">
    <div class="shadow absolute left-1/2"></div>
    <div class="tilt">
      <div class="disc relative">
        <!-- Malla del cuenco -->
        <div class="mesh absolute inset-0">
          {
            rings.map((r, ri) => (
              <div class="ring absolute top-1/2 left-1/2 rounded-full" style={`width:${r * 100}%; height:${r * 100}%; --z:${z(r)}px; --o:${0.14 + (1 - r) * 0.14}`}>
                <svg viewBox="-100 -100 200 200" class="absolute inset-0 size-full overflow-visible">
                  {Array.from({ length: ringDots(r) }, (_, i) => {
                    const a = (i / ringDots(r)) * Math.PI * 2 + ri * 0.21;
                    return <circle cx={Math.cos(a) * 100} cy={Math.sin(a) * 100} r={1.5 / r ** 0.35} fill="currentColor" fill-opacity={0.26 + (1 - r) * 0.28} />;
                  })}
                </svg>
              </div>
            ))
          }
        </div>

        <!-- Pulso de lectura: un anillo ámbar que viaja hacia el centro -->
        <div class="pulse absolute top-1/2 left-1/2 rounded-full"></div>

        <!-- Centro: el mejor ajuste -->
        <div class="core absolute top-1/2 left-1/2" style={`--z:${z(0) + 4}px`}>
          <span class="core-glow absolute inset-0 rounded-full"></span>
        </div>

        <!-- Órbitas con hojas de vida que giran de frente -->
        {
          orbits.map((o) => (
            <div class="lane absolute inset-0" style={`--dur:${o.dur}s`}>
              {o.docs.map((deg) => {
                const a = (deg * Math.PI) / 180;
                return (
                  <div class="pos absolute" style={`left:${50 + Math.cos(a) * o.r * 50}%; top:${50 + Math.sin(a) * o.r * 50}%; --z:${z(o.r) + 30}px`}>
                    <div class="counter" style={`--dur:${o.dur}s`}>
                      <div class="upright">
                        <div class:list={["doc", `is-${o.level}`]}>
                          <span class="fold" />
                          <span class="l w-[60%]" />
                          <span class="l hl w-[84%]" />
                          <span class="l w-[70%]" />
                          <span class="l w-[48%]" />
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          ))
        }

        <!-- Aro con grosor -->
        {Array.from({ length: WALL }, (_, i) => <div class="wall absolute inset-0 rounded-full" style={`--z:${-i * 2.2}px; --o:${i === 0 ? 0.5 : 0.2 - i * 0.013}`} />)}
        <div class="lip absolute inset-0 rounded-full"></div>
      </div>
    </div>
  </div>

</div>

<style>
  .orbit {
    color: var(--ink);
  }
  .glow {
    background-image: radial-gradient(closest-side, rgb(242 169 59 / 0.13), transparent);
    animation: breathe 7s var(--ease-in-out-soft) infinite;
  }
  .stage {
    transform: translate(-50%, -52%);
    perspective: 1100px;
    perspective-origin: 50% 15%;
  }
  .shadow {
    top: 62%;
    width: min(68vw, 560px);
    height: 120px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.7), transparent);
    filter: blur(18px);
  }
  .tilt {
    transform-style: preserve-3d;
    animation: sway 18s var(--ease-in-out-soft) infinite;
  }
  @keyframes sway {
    0%,
    100% {
      transform: rotateY(-6deg) rotateZ(-2deg);
    }
    50% {
      transform: rotateY(6deg) rotateZ(2deg);
    }
  }
  .disc {
    width: min(74vw, 600px);
    aspect-ratio: 1;
    transform: rotateX(62deg);
    transform-style: preserve-3d;
  }
  .mesh {
    transform-style: preserve-3d;
    animation: turn 160s linear infinite;
  }
  .ring {
    transform: translate(-50%, -50%) translateZ(var(--z));
    box-shadow: inset 0 0 0 1px rgb(237 242 238 / var(--o));
  }
  .wall {
    transform: translateZ(var(--z));
    box-shadow: inset 0 0 0 1.5px rgb(237 242 238 / var(--o));
  }
  .lip {
    transform: translateZ(1px);
    box-shadow:
      inset 0 0 0 2px rgb(237 242 238 / 0.28),
      0 0 0 1px rgb(242 169 59 / 0.18),
      0 0 60px -12px rgb(242 169 59 / 0.35);
  }

  /* Pulso: aparece en el borde y se encoge hasta el centro, bajando con el cuenco. */
  .pulse {
    width: 100%;
    height: 100%;
    box-shadow:
      inset 0 0 0 2px rgb(242 169 59 / 0.65),
      0 0 24px rgb(242 169 59 / 0.35);
    transform: translate(-50%, -50%) translateZ(0) scale(1);
    opacity: 0;
    animation: pulse-in 5s var(--ease-in-out-soft) infinite;
  }
  @keyframes pulse-in {
    0% {
      transform: translate(-50%, -50%) translateZ(0) scale(1);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    70% {
      opacity: 0.8;
    }
    100% {
      transform: translate(-50%, -50%) translateZ(-88px) scale(0.06);
      opacity: 0;
    }
  }
  .core {
    transform-style: preserve-3d;
    width: 70px;
    height: 70px;
    transform: translate(-50%, -50%) translateZ(var(--z));
  }
  .core-glow {
    background: radial-gradient(closest-side, rgb(242 169 59 / 0.9), rgb(242 169 59 / 0.25) 55%, transparent);
    animation: breathe 3.6s var(--ease-in-out-soft) infinite;
  }

  /* Órbitas: el carril gira; cada hoja contrarrota para seguir de frente. */
  .lane {
    transform-style: preserve-3d;
    animation: turn var(--dur) linear infinite;
  }
  .pos {
    transform-style: preserve-3d;
    transform: translate(-50%, -50%) translateZ(var(--z));
  }
  .counter {
    transform-style: preserve-3d;
    animation: turn var(--dur) linear infinite reverse;
  }
  .upright {
    transform-style: preserve-3d;
    transform: rotateX(-62deg) translateY(-14px);
  }
  @keyframes turn {
    to {
      transform: rotateZ(360deg);
    }
  }
  /* Hojas de vida en órbita: vidrio oscuro con borde fino y líneas tenues.
     Las del anillo interior llevan su línea marcada en ámbar y brillan. */
  .doc {
    position: relative;
    display: flex;
    width: 30px;
    height: 38px;
    flex-direction: column;
    gap: 3.5px;
    padding: 9px 6px 6px;
    border-radius: 5px;
    border: 1px solid rgb(237 242 238 / 0.18);
    background: rgb(20 30 25 / 0.94);
    box-shadow: 0 12px 22px -12px rgb(0 0 0 / 0.9);
  }
  .doc .fold {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    border-bottom-left-radius: 3px;
    border-left: 1px solid rgb(237 242 238 / 0.18);
    border-bottom: 1px solid rgb(237 242 238 / 0.18);
    background: #0d1411;
  }
  .doc .l {
    position: relative;
    display: block;
    height: 2px;
    border-radius: 2px;
    background: rgb(237 242 238 / 0.28);
  }
  .doc.is-far {
    opacity: 0.45;
  }
  .doc.is-mid .hl {
    background: rgb(242 169 59 / 0.55);
  }
  .doc.is-fit {
    border-color: rgb(242 169 59 / 0.6);
    box-shadow:
      0 0 18px -2px rgb(242 169 59 / 0.35),
      0 12px 22px -12px rgb(0 0 0 / 0.9);
  }
  .doc.is-fit .fold {
    border-color: rgb(242 169 59 / 0.6);
  }
  .doc.is-fit .hl {
    height: 3px;
    background: var(--amber);
    box-shadow: 0 0 8px rgb(242 169 59 / 0.7);
  }

  /* La vacante flota sobre el cuenco; una línea fina baja hasta su centro. */
  .pin-line {
    width: 1px;
    height: 248px;
    background: linear-gradient(to bottom, rgb(242 169 59 / 0.6), rgb(242 169 59 / 0));
  }
  .vacancy {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    border-radius: 14px;
    border: 1px solid rgb(242 169 59 / 0.45);
    background: rgb(20 30 25 / 0.96);
    padding: 8px 14px 8px 8px;
    box-shadow:
      0 0 0 4px rgb(242 169 59 / 0.08),
      0 18px 36px -16px rgb(0 0 0 / 0.95);
  }
  .vacancy-icon {
    display: flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--amber);
    color: #0d1411;
  }
  .vacancy-icon svg {
    width: 16px;
    height: 16px;
  }
  .vacancy-title {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  [data-offscreen] .tilt,
  [data-offscreen] .mesh,
  [data-offscreen] .lane,
  [data-offscreen] .counter,
  [data-offscreen] .pulse {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .tilt,
    .mesh,
    .lane,
    .counter,
    .pulse,
    .glow,
    .core-glow {
      animation: none;
    }
  }
</style>
