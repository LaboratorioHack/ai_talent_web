---
/**
 * Tres pasos, cada uno con una demo viva que se repite sola. Una línea ámbar
 * baja por la izquierda siguiendo el scroll y une los pasos.
 */
const files = [
  { ext: "PDF", name: "hoja_de_vida_2026.pdf", note: "dos columnas", rot: "-2deg" },
  { ext: "JPG", name: "IMG_4402.jpg", note: "foto del celular, torcida", rot: "2.5deg" },
  { ext: "DOCX", name: "CV ingeniera.docx", note: "plantilla de ATS", rot: "-1deg" },
  { ext: "PDF", name: "escaneo_firmado.pdf", note: "escaneo borroso", rot: "1.5deg" },
];
---

<section id="como-evalua" class="relative scroll-mt-24 py-28 sm:py-40">
  <div class="container-x">
    <div class="mx-auto flex max-w-[720px] flex-col items-center gap-4 text-center">
      <span data-reveal class="eyebrow">Cómo evalúa</span>
      <h2 data-reveal style="--i:1" class="font-head text-[36px] leading-[1.05] font-semibold tracking-[-0.02em] sm:text-[52px]">
        Lo que un reclutador haría con calma, con cada una.
      </h2>
      <p data-reveal style="--i:2" class="max-w-[560px] text-[16px] leading-relaxed text-ink-2">
        Por cada vacante llegan cientos de hojas de vida y se leen en diagonal. Criba las lee todas igual de bien, a la primera.
      </p>
    </div>

    <div data-scroll data-end="0.2" class="steps relative mt-24 flex flex-col gap-28 sm:gap-36">
      <div aria-hidden="true" class="absolute top-0 bottom-0 left-[19px] hidden w-px bg-border md:block">
        <span class="line-fill absolute inset-x-0 top-0 h-full origin-top bg-linear-to-b from-ink via-ink to-transparent"></span>
      </div>

      <!-- 1 · Lee cualquier formato -->
      <article class="step grid items-center gap-10 md:grid-cols-[1fr_1.05fr] md:pl-20">
        <div class="flex flex-col gap-4">
          <span data-reveal class="step-n">01</span>
          <h3 data-reveal style="--i:1" class="font-head text-[28px] leading-tight font-semibold sm:text-[34px]">Lee cualquier hoja de vida</h3>
          <p data-reveal style="--i:2" class="max-w-[440px] text-[15.5px] leading-relaxed text-ink-2">
            PDF, DOCX, fotos del celular o escaneos. Plantilla de ATS o diseño libre. Reconoce experiencia, formación, certificaciones e idiomas aunque cada CV los ordene distinto, y avisa cuál no pudo leer.
          </p>
        </div>
        <div data-reveal="" style="--i:1" class="stage" data-loop="5" data-ms="1500">
          <div class="relative h-[300px]">
            {
              files.map((f, i) => (
                <div data-at={i} class="file absolute left-1/2 flex w-[300px] items-center gap-3 rounded-lg border border-border bg-surface p-3.5" style={`--rot:${f.rot}; --y:${i * 58 + 14}px`}>
                  <span class="flex h-11 w-9 shrink-0 items-center justify-center rounded-md bg-surface-2 font-mono text-[9.5px] font-semibold text-ink-2">{f.ext}</span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="truncate text-[13px] text-ink">{f.name}</span>
                    <span class="text-[11.5px] text-ink-3">{f.note}</span>
                  </span>
                  <span class="read flex items-center gap-1.5 rounded-full bg-success-soft px-2 py-0.5 text-[10.5px] text-success">
                    <svg viewBox="0 0 24 24" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                    leído
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </article>

      <!-- 2 · Define qué importa -->
      <article class="step grid items-center gap-10 md:grid-cols-[1fr_1.05fr] md:pl-20">
        <div class="flex flex-col gap-4">
          <span data-reveal class="step-n">02</span>
          <h3 data-reveal style="--i:1" class="font-head text-[28px] leading-tight font-semibold sm:text-[34px]">Define qué importa</h3>
          <p data-reveal style="--i:2" class="max-w-[440px] text-[15.5px] leading-relaxed text-ink-2">
            Requisitos obligatorios, deseables y descalificantes, con pesos que suman 100. Y equivalencias propias, porque AWS no es lo mismo que Azure, pero tampoco es cero.
          </p>
        </div>
        <div data-reveal style="--i:1" class="stage" data-loop="4" data-ms="1900">
          <div class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-6">
            {
              [
                { name: "Azure (AKS, DevOps)", type: "Obligatorio", a: 25, b: 30 },
                { name: "Kubernetes en producción", type: "Obligatorio", a: 20, b: 20 },
                { name: "Cert. Azure Architect", type: "Deseable", a: 15, b: 10 },
                { name: "Inglés B2+", type: "Obligatorio", a: 10, b: 10 },
              ].map((r) => (
                <div class="flex items-center gap-3">
                  <span class="min-w-0 flex-1 truncate text-[13px] text-ink">{r.name}</span>
                  <span class:list={["rounded-md px-2 py-0.5 text-[10.5px]", r.type === "Obligatorio" ? "bg-ink text-paper" : "bg-surface-2 text-ink"]}>{r.type}</span>
                  <span class="weight w-7 text-right font-mono text-[12px] text-ink-2" data-a={r.a} data-b={r.b}>
                    <span data-at="0" data-until="2" class="wa">{r.a}</span>
                    <span data-at="2" class="wb">{r.b}</span>
                  </span>
                </div>
              ))
            }
            <div class="mt-3 flex h-2.5 gap-0.5 overflow-hidden rounded-full bg-surface-2">
              <span data-at="2" class="w-seg bg-ink" style="--a:25; --b:30"></span>
              <span data-at="2" class="w-seg bg-ink/80" style="--a:20; --b:20"></span>
              <span data-at="2" class="w-seg bg-ink-3" style="--a:15; --b:10"></span>
              <span data-at="2" class="w-seg bg-ink/60" style="--a:10; --b:10"></span>
              <span data-at="2" class="w-seg bg-ink-3/50" style="--a:30; --b:30"></span>
            </div>
            <div class="mt-1 flex items-center justify-between">
              <span data-at="1" class="eq inline-flex items-center gap-1.5 rounded-full bg-blue-soft px-2.5 py-1 font-mono text-[10.5px] text-blue">AWS cuenta 80 % de Azure</span>
              <span class="font-mono text-[11px] text-success">100 / 100</span>
            </div>
          </div>
        </div>
      </article>

      <!-- 3 · Ranking con pruebas -->
      <article class="step grid items-center gap-10 md:grid-cols-[1fr_1.05fr] md:pl-20">
        <div class="flex flex-col gap-4">
          <span data-reveal class="step-n">03</span>
          <h3 data-reveal style="--i:1" class="font-head text-[28px] leading-tight font-semibold sm:text-[34px]">Lee el ranking con pruebas</h3>
          <p data-reveal style="--i:2" class="max-w-[440px] text-[15.5px] leading-relaxed text-ink-2">
            Cumple, cumple parcialmente o no cumple. Cada punto lleva la cita del CV y la página, el nivel de confianza y lo que conviene validar en la entrevista.
          </p>
        </div>
        <div data-reveal style="--i:1" class="stage" data-loop="5" data-ms="1500">
          <div class="flex flex-col gap-4 rounded-xl border border-border bg-surface p-6">
            <div class="flex items-center justify-between">
              <span class="text-[13px] font-medium text-ink">Terraform o IaC</span>
              <span class="font-mono text-[10.5px] text-ink-3">Obligatorio · 15</span>
            </div>
            <p class="cite font-head text-[20px] leading-snug text-ink">
              “<span data-at="1" class="marker">Infraestructura como código con Terraform y Bicep</span>, 3 ambientes.”
            </p>
            <div class="flex items-center justify-between">
              <span data-at="2" class="where inline-flex items-center gap-1.5 font-mono text-[11px] text-blue"><svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>CV pág. 2 · 2022–2025</span>
              <span data-at="3" class="pts font-mono text-[18px] font-semibold text-success">+15</span>
            </div>
            <div class="flex items-center gap-3 border-t border-border pt-4">
              <span class="text-[11.5px] text-ink-3">Confianza</span>
              <span class="flex gap-1">
                {[0, 1, 2, 3, 4].map((i) => <span data-at={i < 4 ? 3 : 99} class="conf h-1.5 w-5 rounded-full bg-surface-2" style={`--d:${i * 90}ms`} />)}
              </span>
              <span data-at="3" class="pts ml-auto font-mono text-[11px] text-ink-2">90 %</span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .line-fill {
    scale: 1 var(--p, 0);
  }
  .step-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  /* 1 · archivos que llegan apilados y se marcan como leídos */
  .file {
    translate: -50% calc(var(--y) + 30px);
    rotate: var(--rot);
    opacity: 0;
    box-shadow: 0 18px 36px -20px rgb(0 0 0 / 0.75);
  }
  .file.is-on {
    translate: -50% var(--y);
    opacity: 1;
  }
  .file .read {
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 400ms var(--ease-out-soft) 500ms,
      scale 500ms var(--ease-spring) 500ms;
  }
  .file.is-on .read {
    opacity: 1;
    scale: 1;
  }

  /* 2 · pesos que se reequilibran sin dejar de sumar 100 */
  .w-seg {
    flex: var(--a) 0 0;
    transition: flex-grow 1200ms var(--ease-in-out-soft);
  }
  .w-seg.is-on {
    flex-grow: var(--b);
  }
  .weight {
    position: relative;
    display: inline-grid;
  }
  .weight > span {
    grid-area: 1 / 1;
    transition:
      opacity 500ms var(--ease-out-soft),
      translate 600ms var(--ease-out-soft);
  }
  .weight .wa:not(.is-on),
  .weight .wb:not(.is-on) {
    opacity: 0;
    translate: 0 6px;
  }
  .weight[data-a="20"] .wb,
  .weight[data-a="10"] .wb {
    transition: none;
  }
  .eq {
    opacity: 0;
    scale: 0.85;
  }
  .eq.is-on {
    opacity: 1;
    scale: 1;
  }

  /* 3 · la cita se subraya, aparece la página y suma el punto */
  .where,
  .pts {
    opacity: 0;
    translate: 0 6px;
  }
  .where.is-on,
  .pts.is-on {
    opacity: 1;
    translate: 0 0;
  }
  .pts.is-on {
    animation: pop 600ms var(--ease-spring);
  }
  .conf {
    transition: background-color 500ms var(--ease-out-soft) var(--d);
  }
  .conf.is-on {
    background: var(--success);
  }
</style>
