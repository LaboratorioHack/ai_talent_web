---
/**
 * Marca de Criba: una hoja con la esquina doblada y una línea marcada con el
 * resaltador ámbar (la hoja de vida leída). En la landing, oscura, la hoja es clara.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class:list={["logo inline-flex items-center gap-[9px]", className]} aria-label="Criba">
  <svg viewBox="0 0 24 28" width="24" height="28" aria-hidden="true" class="mark shrink-0">
    <path d="M4 1h11.2L22 7.8V24a3 3 0 0 1-3 3H4a3 3 0 0 1-3-3V4a3 3 0 0 1 3-3Z" fill="#f5f1e8"></path>
    <path d="M15.2 1v4.3a2.5 2.5 0 0 0 2.5 2.5H22" fill="#d9d2c3"></path>
    <rect x="5" y="10.5" width="9" height="2" rx="1" fill="#15201b" opacity="0.5"></rect>
    <rect class="hl" x="3.6" y="14.6" width="15.2" height="4.4" rx="1.3" fill="#f2a93b"></rect>
    <rect x="5" y="15.8" width="12" height="2" rx="1" fill="#15201b"></rect>
    <rect x="5" y="21.2" width="7" height="2" rx="1" fill="#15201b" opacity="0.5"></rect>
  </svg>
  <span class="font-head text-[19px] font-semibold tracking-[-0.02em] text-ink">criba</span>
</span>

<style>
  /* Al pasar el ratón, el resaltador se vuelve a pasar sobre la línea. */
  .hl {
    transform-box: fill-box;
    transform-origin: left;
  }
  .logo:hover .hl {
    animation: swipe 700ms var(--ease-out-soft) both;
  }
  @keyframes swipe {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
