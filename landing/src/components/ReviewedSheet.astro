---
/**
 * La pieza central de la landing: una hoja de vida estándar, en papel, que
 * Criba revisa sola en bucle. El resaltador marca cada frase que prueba un
 * requisito, la nota aparece en el margen con sus puntos y al final cae el
 * sello. Con el scroll, las otras hojas del montón se abren en abanico.
 * Tipografía de documento (serif clásica), como un CV hecho en Word.
 */
type Note = { req: string; pts: number; partial?: boolean };
type Line = { kind: "role" | "bullet" | "text"; text: string; right?: string; note?: Note; at?: number };
type Block = { title: string; lines: Line[] };

const blocks: Block[] = [
  {
    title: "Perfil",
    lines: [{ kind: "text", text: "Ingeniera de plataforma con 7 años en nube y automatización. Me gusta dejar la infraestructura documentada y repetible." }],
  },
  {
    title: "Experiencia",
    lines: [
      { kind: "role", text: "Ingeniera de plataforma — Banco digital", right: "2022 – 2025", note: { req: "Sector financiero", pts: 13 }, at: 5 },
      { kind: "bullet", text: "Migré 40 microservicios a AKS y diseñé los pipelines en Azure DevOps.", note: { req: "Azure (AKS, DevOps)", pts: 25 }, at: 2 },
      { kind: "bullet", text: "Operé clústeres AKS y GKE con 99,95 % de disponibilidad.", note: { req: "Kubernetes en producción", pts: 20 }, at: 3 },
      { kind: "bullet", text: "Infraestructura como código con Terraform y Bicep en 3 ambientes.", note: { req: "Terraform o IaC", pts: 15 }, at: 4 },
      { kind: "role", text: "DevOps Engineer — Comercio minorista", right: "2019 – 2022" },
      { kind: "bullet", text: "Automaticé despliegues y monitoreo con Prometheus y Grafana." },
    ],
  },
  {
    title: "Educación",
    lines: [{ kind: "role", text: "Ingeniería de Sistemas — Universidad pública", right: "2018" }],
  },
  {
    title: "Certificaciones",
    lines: [{ kind: "text", text: "AWS Certified Solutions Architect – Professional (2024)", note: { req: "Cert. Azure · equivale 60 %", pts: 9, partial: true }, at: 6 }],
  },
  {
    title: "Idiomas",
    lines: [{ kind: "text", text: "Inglés C1 (IELTS 7.5) · Español nativo", note: { req: "Inglés B2+", pts: 10 }, at: 7 }],
  },
];

const totals = [
  { at: 2, v: 25 },
  { at: 3, v: 45 },
  { at: 4, v: 60 },
  { at: 5, v: 73 },
  { at: 6, v: 82 },
  { at: 7, v: 92 },
];
const behind = [
  { name: "Andrés Felipe Ruiz", role: "Ingeniero DevOps", rot: -7, x: -170 },
  { name: "Carolina Mejía Ortiz", role: "Arquitecta de soluciones", rot: 6, x: 170 },
  { name: "Juan Pablo Ramírez", role: "Administrador de sistemas", rot: -3, x: -80 },
];
---

<div data-scroll data-end="0.25" class="sheet-stage relative mt-20 w-full max-w-[1000px] sm:mt-24">
  <!-- El resto del montón: otras hojas de vida, con su encabezado y secciones -->
  {
    behind.map((b) => (
      <div aria-hidden="true" class="behind paper cv absolute inset-x-[8%] top-6 bottom-0 rounded-[2px] px-14 pt-12" style={`--rot:${b.rot}deg; --x:${b.x}px`}>
        <p class="text-center text-[22px] font-bold tracking-wide">{b.name}</p>
        <p class="mt-1 text-center text-[13px] text-ink-2">{b.role}</p>
        <div class="mt-6 border-b border-ink/40 pb-1 text-[11px] font-bold tracking-[0.14em] uppercase">Experiencia</div>
        <div class="mt-3 flex flex-col gap-2.5">
          {[86, 72, 80, 64].map((w) => (
            <span class="h-[7px] rounded-[1px] bg-ink/15" style={`width:${w}%`} />
          ))}
        </div>
      </div>
    ))
  }

  <article
    data-loop="9"
    data-ms="1500"
    class="sheet paper cv relative rounded-[2px] text-left"
    aria-label="Ejemplo: Criba revisa una hoja de vida y marca la evidencia de cada requisito"
  >
    <span data-hold="8" data-hold-ms="2800" hidden></span>

    <!-- Columna del margen: notas de la revisión, a 250px del borde derecho -->
    <span aria-hidden="true" class="absolute inset-y-0 right-[250px] hidden border-l border-dashed border-border md:block"></span>

    <div class="px-8 pt-10 pb-12 sm:px-14 sm:pt-12 md:pr-0">
      <header class="row pb-2">
        <div class="flex flex-col items-center text-center">
          <p class="text-[26px] leading-tight font-bold tracking-wide text-ink">Mariana Restrepo Gil</p>
          <p class="mt-1 text-[14px] text-ink-2 italic">Ingeniera de plataforma cloud</p>
          <p class="mt-2 text-[12px] text-ink-3">mariana.restrepo@correo.com · +57 300 000 0000 · Medellín, Colombia</p>
        </div>
        <div class="margin hidden flex-col items-end justify-start gap-1 md:flex">
          <span class="note-label">Revisión de Criba</span>
          <span class="score-stack text-[26px] leading-none font-bold text-ink tabular-nums">
            <span data-at="0" data-until="2" class="total">0</span>
            {totals.map((t, i) => (
              <span data-at={t.at} data-until={totals[i + 1]?.at ?? 99} class="total">{t.v}</span>
            ))}
            <span class="ml-0.5 text-[12px] font-normal text-ink-3">/100</span>
          </span>
        </div>
      </header>

      {
        blocks.map((block) => (
          <section class="mt-5">
            <h4 class="row">
              <span class="cv-heading">{block.title}</span>
              <span class="margin hidden md:block" />
            </h4>
            <ul class="mt-1.5 flex flex-col">
              {block.lines.map((l) => (
                <li data-at={l.at ?? 99} class:list={["row line items-center", l.kind === "role" ? "pt-2 pb-0.5" : "py-[3px]", l.note?.partial && "partial"]}>
                  <span class="flex min-w-0 items-baseline gap-3">
                    {l.kind === "bullet" && <span aria-hidden="true" class="bullet" />}
                    <span class:list={["min-w-0 text-[14px] leading-snug", l.kind === "role" ? "font-bold text-ink" : "text-ink-2"]}>
                      <span class="marker">{l.text}</span>
                    </span>
                    {l.note && <span class="leader ml-1 hidden h-px min-w-6 flex-1 self-center md:block" />}
                    {l.right && !l.note && <span class="ml-auto shrink-0 text-[13px] text-ink-3 italic">{l.right}</span>}
                    {l.right && l.note && <span class="shrink-0 text-[13px] text-ink-3 italic">{l.right}</span>}
                  </span>
                  <span class="margin hidden md:block">
                    {l.note && (
                      <span class="note flex items-center justify-between gap-3">
                        <span class="min-w-0 truncate">{l.note.req}</span>
                        <span class:list={["shrink-0 font-semibold tabular-nums", l.note.partial ? "text-warning" : "text-success"]}>+{l.note.pts}</span>
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- Sello -->
    <div data-at="8" class="stamp pointer-events-none absolute top-[200px] right-12 hidden md:flex" aria-hidden="true">
      <div class="flex flex-col items-center rounded-md border-[2.5px] border-success px-4 py-2 text-success">
        <span class="text-[10px] font-bold tracking-[0.2em] uppercase">Cumple</span>
        <span class="text-[30px] leading-none font-bold">92</span>
        <span class="text-[9.5px] font-bold tracking-[0.12em] uppercase">4 de 4 obligatorios</span>
      </div>
    </div>
  </article>

  <p class="mt-6 text-[12.5px] text-ink-3">Una de las hojas de vida de la vacante Ingeniero Cloud Senior, revisada por Criba.</p>
</div>

<style>
  /* Tipografía de documento: serif clásica, como un CV hecho en Word. */
  .cv {
    font-family: Georgia, "Times New Roman", Times, serif;
  }
  .cv-heading {
    display: block;
    border-bottom: 1px solid color-mix(in oklab, var(--ink) 45%, transparent);
    padding-bottom: 3px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  /* Las notas de la revisión no son parte del CV: van en sans, como anotación. */
  .note,
  .note-label {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--ink);
  }
  .note-label {
    font-size: 11px;
    color: var(--ink-3);
  }
  .stamp {
    font-family: var(--font-sans);
  }
  /* Viñeta dibujada: un punto de tinta, no un carácter. */
  .bullet {
    flex-shrink: 0;
    width: 4px;
    height: 4px;
    margin-left: 4px;
    border-radius: 999px;
    background: var(--ink-2);
    align-self: center;
  }
  /* Hoja de papel: canto apenas visible, sombra de contacto y sombra larga sobre el escritorio. */
  .sheet {
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.35),
      0 1px 1px rgb(0 0 0 / 0.25),
      0 24px 40px -18px rgb(0 0 0 / 0.65),
      0 70px 120px -50px rgb(0 0 0 / 0.9);
  }
  /* Esquina doblada arriba a la derecha. */
  .sheet::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 34px;
    height: 34px;
    background: linear-gradient(225deg, var(--paper) 50%, #ddd6c6 50%, #f0ebe0 100%);
    box-shadow: -3px 3px 6px -2px rgb(0 0 0 / 0.25);
    border-bottom-left-radius: 3px;
  }
  /* Las demás hojas se abren en abanico con el scroll (--p de motion.ts). */
  .behind {
    transform: translateX(calc(var(--x) * var(--p, 0))) rotate(calc(var(--rot) * var(--p, 0))) translateY(calc(var(--p, 0) * 14px));
    opacity: calc(0.55 + var(--p, 0) * 0.45);
    filter: brightness(calc(0.72 + var(--p, 0) * 0.12));
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.3),
      0 30px 60px -30px rgb(0 0 0 / 0.85);
  }

  /* Evidencia: el resaltador y la guía hacia el margen. */
  .line .marker {
    transition-duration: 900ms;
  }
  .line:not(.is-on) .marker {
    transition-duration: 300ms;
  }
  .line.is-on .marker {
    background-size: 100% 100%;
  }
  .line.partial {
    --marker: rgb(217 139 15 / 0.22);
  }
  .leader {
    background-image: linear-gradient(to right, var(--ink-3) 50%, transparent 50%);
    background-size: 6px 1px;
    opacity: 0;
    transition: opacity 500ms var(--ease-out-soft) 500ms;
  }
  .line.is-on .leader {
    opacity: 0.55;
  }

  /* Cada fila: el texto de la hoja y, a la derecha, su nota en el margen. */
  .row {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .row {
      grid-template-columns: 1fr 250px;
    }
  }
  .margin {
    padding-inline: 24px;
  }
  .note {
    opacity: 0;
    translate: -10px 0;
    transition:
      opacity 600ms var(--ease-out-soft) 350ms,
      translate 700ms var(--ease-out-soft) 350ms;
  }
  .line.is-on .note {
    opacity: 1;
    translate: 0 0;
  }

  .score-stack {
    display: inline-flex;
    align-items: baseline;
  }
  .score-stack .total {
    display: none;
  }
  .score-stack .total.is-on {
    display: inline;
    animation: pop 450ms var(--ease-spring);
  }

  .stamp {
    opacity: 0;
    scale: 1.6;
    rotate: -9deg;
  }
  .stamp.is-on {
    opacity: 1;
    scale: 1;
    transition:
      opacity 250ms ease-out,
      scale 420ms cubic-bezier(0.5, 0, 0.3, 1.4);
  }
</style>
