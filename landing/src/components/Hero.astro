---
const asset = (file: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/img/${file}`;
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
const facts = ["Lee PDF, Word y escaneos", "Evalúa sin foto, edad ni datos personales", "Tu equipo toma la decisión final"];
---

<!--
  Hero: la promesa en una frase y el producto real debajo. La composición entra
  inclinada hacia atrás y se endereza mientras se baja (data-scrub), sin fijar
  la página: el movimiento sigue al scroll en las dos direcciones.
-->
<section class="pt-32 sm:pt-40">
  <div class="container-x flex flex-col">
    <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <div class="flex flex-col items-start">
        <p data-reveal class="eyebrow">Selección de personal con IA, para empresas en Colombia</p>
        <h1 data-reveal style="--i:1" class="mt-5 font-head text-[42px] leading-[1.03] font-semibold tracking-[-0.03em] text-balance sm:text-[62px] lg:text-[72px]">
          Contrata por lo que la gente <span class="marker">sabe hacer</span>.
        </h1>
      </div>
      <div class="flex flex-col items-start gap-8 lg:pb-3">
        <p data-reveal style="--i:2" class="text-[18px] leading-relaxed text-ink-2">
          Criba lee cada hoja de vida completa, la compara con tu vacante y te muestra la línea que prueba cada requisito. Tú decides a quién llamar.
        </p>
        <div data-reveal style="--i:3" class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={`${appUrl}/login`} class="btn btn-ink">Publicar una vacante</a>
          <a href="#postulantes" class="link-arrow text-[15px]">
            Busco empleo
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <ul data-reveal style="--i:4" class="mt-10 flex flex-wrap gap-x-8 gap-y-2.5 text-[14.5px] text-ink-2">
      {
        facts.map((f) => (
          <li class="flex items-center gap-2.5">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--success)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {f}
          </li>
        ))
      }
    </ul>

    <div class="hero-stage mt-14 sm:mt-20" data-scrub data-scrub-end="0.12">
      <div class="hero-tilt relative pb-[12%]">
        <figure class="shot">
          <img src={asset("app-home.webp")} alt="Inicio de Criba: vacantes abiertas, hojas de vida recibidas, embudo de selección y lo que Criba AI está haciendo" width="2000" height="1250" fetchpriority="high" />
        </figure>
        <figure class="hero-card shot absolute -bottom-0 left-[4%] w-[62%] sm:w-[48%]">
          <img src={asset("app-score.webp")} alt="Daniela Osorio: cumple 4 de 4 obligatorios, 92 de 100 y de dónde sale cada punto" width="1200" height="402" loading="eager" />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    perspective: 1600px;
  }
  /* --p va de 0 (recién visible) a 1 (asentada): inclinada y chica, luego plana. */
  .hero-tilt {
    transform-origin: 50% 0%;
    transform: rotateX(calc((1 - var(--p, 1)) * 16deg)) scale(calc(0.9 + var(--p, 1) * 0.1));
    will-change: transform;
  }
  .hero-card {
    translate: 0 calc((1 - var(--p, 1)) * 60px);
    opacity: calc(0.35 + var(--p, 1) * 0.65);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.85);
  }
</style>
