---
import Logo from "./Logo.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
const links = [
  { href: "#empresas", label: "Para empresas" },
  { href: "#vacantes", label: "Vacantes" },
  { href: "#como-evalua", label: "Cómo evalúa" },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-4">
  <div class="nav-shell flex h-14 w-full max-w-[1120px] items-center gap-3 rounded-xl border border-transparent px-4 sm:gap-8 sm:px-5">
    <a href="#" aria-label="Inicio"><Logo /></a>
    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <a href={l.href} class="rounded-md px-3 py-1.5 text-[13.5px] text-ink-2 transition-colors duration-300 hover:bg-surface-2 hover:text-ink">
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="flex-1"></div>
    <a href={`${appUrl}/login`} class="hidden text-[13.5px] font-medium text-ink-2 transition-colors hover:text-ink sm:inline">Entrar</a>
    <a href={`${appUrl}/portal/sign-in`} class="hidden h-9 items-center rounded-md px-3 text-[13.5px] font-medium text-ink-2 transition-colors hover:text-ink lg:inline-flex">Portal postulantes</a>
    <a href={`${appUrl}/login`} class="btn btn-ink h-9 rounded-md px-4 text-[13px]">Publicar vacante</a>
    <button type="button" class="menu-btn -mr-2 flex size-10 items-center justify-center rounded-lg text-ink md:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
      <svg viewBox="0 0 20 20" class="size-5" aria-hidden="true">
        <path class="bar bar-1" d="M3 6.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <path class="bar bar-2" d="M3 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Menú de celular: las secciones y las dos entradas -->
  <div id="nav-menu" class="menu absolute inset-x-4 top-[calc(100%+8px)] flex flex-col rounded-xl border border-border p-2 md:hidden" data-open="false">
    {
      links.map((l) => (
        <a href={l.href} class="rounded-lg px-4 py-3 text-[15px] text-ink transition-colors hover:bg-surface-2">
          {l.label}
        </a>
      ))
    }
    <span class="my-1 h-px bg-border"></span>
    <a href={`${appUrl}/portal/sign-in`} class="rounded-lg px-4 py-3 text-[15px] text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink">Portal de postulantes</a>
    <a href={`${appUrl}/login`} class="rounded-lg px-4 py-3 text-[15px] text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink">Entrar</a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const menu = document.getElementById("nav-menu");
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };
    btn.addEventListener("click", () => set(menu.dataset.open !== "true"));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => e.key === "Escape" && set(false));
    document.addEventListener("pointerdown", (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  .menu {
    background: rgb(20 30 25 / 0.96);
    backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.8);
    transform-origin: top;
    transition:
      opacity 300ms var(--ease-out-soft),
      transform 400ms var(--ease-out-soft),
      visibility 0ms linear 400ms;
  }
  .menu[data-open="false"] {
    opacity: 0;
    transform: translateY(-6px) scaleY(0.97);
    visibility: hidden;
    pointer-events: none;
  }
  .menu[data-open="true"] {
    transition-delay: 0ms;
  }
  .bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 400ms var(--ease-out-soft);
  }
  .menu-btn[aria-expanded="true"] .bar-1 {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .bar-2 {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .nav-shell {
    transition:
      max-width 800ms var(--ease-out-soft),
      background-color 600ms var(--ease-out-soft),
      border-color 600ms var(--ease-out-soft),
      box-shadow 600ms var(--ease-out-soft);
  }
  #nav[data-scrolled] .nav-shell {
    max-width: 980px;
    background: rgb(20 30 25 / 0.78);
    border-color: var(--border);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.7);
    backdrop-filter: blur(14px) saturate(160%);
  }
</style>
