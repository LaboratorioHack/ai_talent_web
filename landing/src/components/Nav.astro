---
import Logo from "./Logo.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
const links = [
  { href: "#producto", label: "Producto" },
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#postulantes", label: "Busco empleo" },
];
---

<header id="nav" class="nav fixed inset-x-0 top-0 z-50 border-b border-transparent">
  <div class="container-x flex h-16 items-center gap-8">
    <a href="#" aria-label="Inicio"><Logo /></a>
    <nav aria-label="Principal" class="hidden items-center gap-7 md:flex">
      {links.map((l) => <a href={l.href} class="text-[14.5px] text-ink-2 transition-colors hover:text-ink">{l.label}</a>)}
    </nav>
    <div class="flex-1"></div>
    <a href={`${appUrl}/portal/sign-in`} class="hidden h-10 items-center gap-2 rounded-full border border-border-strong px-4 text-[14px] font-medium text-ink transition-colors hover:bg-white/5 lg:inline-flex">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /></svg>
      Portal postulantes
    </a>
    <a href={`${appUrl}/login`} class="hidden text-[14.5px] font-medium text-ink-2 transition-colors hover:text-ink sm:inline">Entrar</a>
    <a href={`${appUrl}/login`} class="btn btn-ink h-10 px-5 text-[14px]">Publicar vacante</a>
    <button type="button" class="menu-btn -mr-2 flex size-10 items-center justify-center rounded-full text-ink md:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
      <svg viewBox="0 0 20 20" class="size-5" aria-hidden="true">
        <path d="M3 6.5h14M3 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div id="nav-menu" class="menu container-x flex flex-col pb-4 md:hidden" data-open="false">
    {links.map((l) => <a href={l.href} class="border-b border-border py-3 text-[16px] text-ink">{l.label}</a>)}
    <a href={`${appUrl}/portal/sign-in`} class="border-b border-border py-3 text-[16px] text-ink">Portal de postulantes</a>
    <a href={`${appUrl}/login`} class="py-3 text-[16px] text-ink">Entrar</a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const menu = document.getElementById("nav-menu");
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      document.getElementById("nav")?.toggleAttribute("data-open", open);
    };
    btn.addEventListener("click", () => set(menu.dataset.open !== "true"));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
  }
</script>

<style>
  .nav {
    transition:
      background-color 300ms var(--ease-out-soft),
      border-color 300ms var(--ease-out-soft);
  }
  .nav[data-scrolled],
  .nav[data-open] {
    background: rgb(14 22 18 / 0.88);
    backdrop-filter: blur(10px);
    border-color: var(--border);
  }
  .menu {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 450ms var(--ease-out-soft),
      opacity 300ms var(--ease-out-soft);
  }
  .menu[data-open="true"] {
    max-height: 320px;
    opacity: 1;
  }
</style>
