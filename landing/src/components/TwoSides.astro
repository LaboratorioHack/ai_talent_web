---
/**
 * Un mismo criterio, explicado a los dos lados. A la izquierda la empresa ve
 * su ranking con la prueba de cada punto; a la derecha quien postula sigue su
 * postulación y sabe qué se tuvo en cuenta. Ninguna animación descarta a
 * nadie: las dos escenas avanzan en bucle mostrando lo que se gana.
 */
const ranking = [
  { name: "Daniela O.", score: 92, why: "40 servicios migrados a AKS" },
  { name: "Julián R.", score: 88, why: "Kubernetes en producción, 5 años" },
  { name: "Mariana L.", score: 78, why: "Terraform en tres ambientes" },
];
const steps = ["Recibida", "Leída completa", "Evaluada", "Entrevista con IA"];
const seen = [
  { label: "Azure (AKS, DevOps)", ok: true },
  { label: "Kubernetes en producción", ok: true },
  { label: "Inglés B2 o más", ok: true },
  { label: "Certificación Azure", ok: false },
];
---

<section id="empresas" class="relative scroll-mt-24 py-28 sm:py-36">
  <div id="personas" class="absolute -top-24" aria-hidden="true"></div>
  <div class="container-x flex flex-col gap-16">
    <div class="mx-auto flex max-w-[760px] flex-col items-center gap-4 text-center">
      <span data-reveal class="eyebrow">Para los dos lados</span>
      <h2 data-reveal style="--i:1" class="font-head text-[36px] leading-[1.05] font-semibold tracking-[-0.025em] sm:text-[52px]">Un mismo criterio, explicado a quien contrata y a quien postula.</h2>
      <p data-reveal style="--i:2" class="max-w-[560px] text-[16px] leading-relaxed text-ink-2">
        La empresa ve por qué alguien encaja. La persona sabe que su hoja de vida se leyó completa y qué se tuvo en cuenta.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2 lg:gap-6">
      <!-- Empresas -->
      <article data-reveal style="--i:1" class="side flex min-w-0 flex-col gap-7 rounded-2xl border border-border bg-surface p-5 sm:gap-8 sm:p-8">
        <div class="flex flex-col gap-3">
          <span class="text-[13px] font-medium text-amber">Si contratas</span>
          <h3 class="font-head text-[24px] sm:text-[28px] leading-tight font-semibold tracking-[-0.015em]">Un ranking que se puede explicar.</h3>
          <ul class="flex flex-col gap-2.5 text-[15px] text-ink-2">
            <li class="point">Publica la vacante con sus requisitos y cuánto pesa cada uno.</li>
            <li class="point">Recibe hojas de vida de tus fuentes o de quienes postulan directo.</li>
            <li class="point">Cada puntaje trae la línea de la hoja de vida que lo prueba. La decisión es de tu equipo.</li>
          </ul>
        </div>

        <div class="scene mt-auto min-w-0 rounded-xl border border-border bg-paper-2 p-4 sm:p-5" data-loop="4" data-ms="1500">
          <div class="mb-4 flex items-center justify-between text-[12.5px]">
            <span class="font-medium text-ink">Ingeniero Cloud Senior</span>
            <span class="text-ink-3">84 evaluadas</span>
          </div>
          <ol class="flex flex-col gap-2.5">
            {
              ranking.map((r, i) => (
                <li data-at={i + 1} class="rank-row flex items-center gap-3 rounded-lg border border-border bg-surface px-3.5 py-3">
                  <span class="w-4 text-center font-mono text-[12px] text-ink-3">{i + 1}</span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="text-[14px] font-medium text-ink">{r.name}</span>
                    <span class="why truncate text-[12.5px] text-ink-3">
                      <span class="marker">{r.why}</span>
                    </span>
                  </span>
                  <span class="score font-head text-[22px] font-semibold text-success tabular-nums">{r.score}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </article>

      <!-- Personas -->
      <article data-reveal style="--i:2" class="side flex min-w-0 flex-col gap-7 rounded-2xl border border-border bg-surface p-5 sm:gap-8 sm:p-8">
        <div class="flex flex-col gap-3">
          <span class="text-[13px] font-medium text-blue">Si buscas empleo</span>
          <h3 class="font-head text-[24px] sm:text-[28px] leading-tight font-semibold tracking-[-0.015em]">Tu hoja de vida, leída completa.</h3>
          <ul class="flex flex-col gap-2.5 text-[15px] text-ink-2">
            <li class="point">Súbela una vez, en el formato que tengas: PDF, Word o una foto.</li>
            <li class="point">Postúlate a las vacantes abiertas y sigue en qué va cada una.</li>
            <li class="point">Sabes qué se tuvo en cuenta. Foto, edad, género y dirección nunca cuentan.</li>
          </ul>
        </div>

        <div class="scene mt-auto min-w-0 rounded-xl border border-border bg-paper-2 p-4 sm:p-5" data-loop="6" data-ms="1300">
          <div class="mb-4 flex items-center justify-between text-[12.5px]">
            <span class="font-medium text-ink">Tu postulación a Ingeniero Cloud Senior</span>
            <span class="text-ink-3">hace 2 días</span>
          </div>
          <ol class="mb-5 grid grid-cols-2 gap-2 sm:grid-cols-4">
            {
              steps.map((s, i) => (
                <li data-at={i + 1} class="step-pill flex flex-col gap-1.5">
                  <span class="bar h-1.5 rounded-full bg-surface-2" />
                  <span class="text-[11.5px] text-ink-3">{s}</span>
                </li>
              ))
            }
          </ol>
          <p class="mb-2.5 text-[12.5px] text-ink-3">Lo que se vio en tu hoja de vida</p>
          <ul class="flex flex-wrap gap-2">
            {
              seen.map((r, i) => (
                <li data-at={i + 2} class:list={["req flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[12.5px]", r.ok ? "is-ok" : "is-tip"]}>
                  <span class="dot size-1.5 rounded-full" />
                  {r.ok ? r.label : `Puedes contar más sobre ${r.label.toLowerCase()}`}
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .point {
    position: relative;
    padding-left: 18px;
  }
  .point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--border-strong);
  }

  /* Ranking: cada fila se enciende y su evidencia se resalta. */
  .rank-row {
    opacity: 0.4;
    translate: 0 6px;
    transition:
      opacity 600ms var(--ease-out-soft),
      translate 700ms var(--ease-out-soft),
      border-color 600ms var(--ease-out-soft);
  }
  .rank-row.is-on {
    opacity: 1;
    translate: 0 0;
    border-color: var(--border-strong);
  }
  .rank-row .marker {
    --marker-delay: 250ms;
  }
  .rank-row:not(.is-on) .marker {
    background-size: 0% 100%;
  }
  .rank-row .score {
    opacity: 0;
    transition: opacity 500ms var(--ease-out-soft) 300ms;
  }
  .rank-row.is-on .score {
    opacity: 1;
  }

  /* Postulación: la barra de cada etapa se llena y los requisitos aparecen. */
  .step-pill .bar {
    position: relative;
    overflow: hidden;
  }
  .step-pill .bar::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--blue);
    scale: 0 1;
    transform-origin: left;
    transition: scale 900ms var(--ease-in-out-soft);
  }
  .step-pill.is-on .bar::after {
    scale: 1 1;
  }
  .step-pill.is-on span:last-child {
    color: var(--ink-2);
  }
  .req {
    opacity: 0;
    scale: 0.92;
    transition:
      opacity 500ms var(--ease-out-soft),
      scale 600ms var(--ease-spring);
  }
  .req.is-on {
    opacity: 1;
    scale: 1;
  }
  .req.is-ok {
    background: var(--success-soft);
    color: var(--success);
  }
  .req.is-ok .dot {
    background: var(--success);
  }
  .req.is-tip {
    background: var(--warning-soft);
    color: var(--warning);
  }
  .req.is-tip .dot {
    background: var(--warning);
  }
</style>
