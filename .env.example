# En local con la API .NET (puerto 5022): el navegador llama a /api y Next lo reenvía a API_INTERNAL_URL,
# porque la API no tiene CORS. En producción Caddy sirve /api/* en el mismo dominio.
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:5022/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# true: las pantallas usan datos de prueba de src/shared/mocks en vez de la API.
NEXT_PUBLIC_USE_MOCKS=true
